<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <context id="MySQLTables" targetRuntime="MyBatis3">


        <!-- 抑制注释生成。不生成注释。 -->
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>


        <!-- mvn mybatis-generator:generate 配置数据库位置 ，配置虚拟机上的mysql ip地址；不采用安全协议连接，否则无法逆向生成 -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://124.223.165.51:3306/yjzs?useSSL=false"
                        userId="root" password="Ab123@wcj">
        </jdbcConnection>


        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>


        <!-- javaBean生成在哪里 -->
        <javaModelGenerator
                targetPackage="com.yjzs.gold.com.bean"
                targetProject="..\yjzs-com\src\main\java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- sqlMap sql映射文件（xml mapper文件） -->
        <sqlMapGenerator targetPackage="mapper"
                         targetProject="..\yjzs-com\src\main\resources">
            <property name="enableSubPackages" value="true"/>
        </sqlMapGenerator>

        <!-- javaClient：java接口生成的地方 -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="com.yjzs.gold.com.mapper"
                             targetProject="..\yjzs-com\src\main\java">
            <property name="enableSubPackages" value="true"/>
        </javaClientGenerator>

        <!--  需要用到的表 -->
        <!-- <table schema="" tableName="%"></table> -->
<!--        <table tableName="t_posts"></table>-->
<!--        <table tableName="t_comment"></table>-->
<!--        <table tableName="t_follow"></table>-->
<!--        <table tableName="t_collect"></table>-->
        <table tableName="t_like"></table>

    </context>
</generatorConfiguration>